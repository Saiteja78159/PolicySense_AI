# Supabase (create project at https://supabase.com)
SUPABASE_URL="your url"
SUPABASE_SERVICE_ROLE_KEY="your key"
# For frontend (use anon key in browser)
VITE_SUPABASE_URL="your url"
VITE_SUPABASE_ANON_KEY="your anon key"
# Groq (https://console.groq.com) - for chat/LLM only
GROQ_API_KEY="your api key"

# Embeddings: default is local (open-source Transformers.js, no API key)
# Optional: EMBED_PROVIDER=local (default) | huggingface | groq
# Only if EMBED_PROVIDER=huggingface:
# HUGGINGFACE_API_KEY=your-hf-token
# HUGGINGFACE_EMBED_MODEL=BAAI/bge-base-en-v1.5

# Optional
# PORT=5000
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# GROQ_EMBED_MODEL=nomic-embed-text-v1.5
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=100
# RAG_TOP_K=6
# RAG_SIMILARITY_THRESHOLD=0.4
